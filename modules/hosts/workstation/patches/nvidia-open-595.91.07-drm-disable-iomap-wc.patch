+/*
+ * Map video memory uncached instead of write-combined in the kernel. Pair with
+ * NVreg_RegistryDwords=RmForceDisableIomapWC=1: a write-combined ioremap of
+ * any part of BAR1 makes the x86 PAT memtype reservation nvidia-uvm needs for
+ * PCI P2PDMA (static BAR1, GPUDirect Storage) fail with a type conflict.
+ */
+MODULE_PARM_DESC(
+    disable_iomap_wc,
+    "Map video memory uncached instead of write-combined (1 = uncached, 0 = write-combined (default))");
+module_param_named(disable_iomap_wc, nv_drm_disable_iomap_wc_module_param, bool, 0400);
+
 #endif /* NV_DRM_AVAILABLE */
 
